<?xml version="1.0"?>
<ruleset
        name="BEAR.Kata"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="vendor-bin/tools/vendor/squizlabs/php_codesniffer/phpcs.xsd"
>
    <description>BEAR.Kata uses the BEAR.Sunday coding standard.</description>
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="80"/>
    <arg name="cache" value=".phpcs-cache"/>

    <!-- PHP version -->
    <config name="php_version" value="80505"/>

    <!-- Ignore warnings, show progress of the run and show sniff names -->
    <arg value="nps"/>

    <!-- Directories to be checked -->
    <file>bin</file>
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>*/bin/semantic-ex/*</exclude-pattern>
    <exclude-pattern>*/tests/tmp/*</exclude-pattern>

    <!-- BEAR.Sunday Coding Standard (extends Doctrine with BEAR-specific sniffs) -->
    <rule ref="BearSunday">
        <!--
            BEAR.Sunday convention: every injectable interface ends in *Interface
            (ResourceInterface, MarkdownRendererInterface, …). The Slevomat sniff
            treats these as superfluous; we treat them as the project's spelling
            of dependency-shape clarity. Candidate to bake into the standard.
        -->
        <exclude name="SlevomatCodingStandard.Classes.SuperfluousInterfaceNaming"/>
        <!--
            Same reasoning for domain exceptions (UnauthorizedException,
            BadRequestException, …) — the *Exception suffix makes catch-site
            search trivial. Candidate to bake into the standard.
        -->
        <exclude name="SlevomatCodingStandard.Classes.SuperfluousExceptionNaming"/>
        <!--
            Abstract test bases (AbstractAppTestCase, AbstractMySQLTestCase) and
            the Abstract* prefix are an established BEAR.Sunday spelling.
            Candidate to bake into the standard.
        -->
        <exclude name="SlevomatCodingStandard.Classes.SuperfluousAbstractClassNaming"/>
        <!--
            Equals-sign alignment makes adding a single variable reformat N
            surrounding lines, producing noisy diffs. Project preference is to
            not align.
        -->
        <exclude name="Generic.Formatting.MultipleStatementAlignment.NotSame"/>
        <!--
            "$var" interpolation reads better than '. $var .' concatenation in
            short strings (e.g. SQL ids). Project preference.
        -->
        <exclude name="Squiz.Strings.DoubleQuoteUsage.ContainsVar"/>
    </rule>

    <!--
        MissingNativeTypeHint conflicts with phpstan's `property.extraNativeType`
        when overriding a parent's untyped property (e.g. ResourceObject::$body).
        Restrict to src/Module/* and tests/* where DI bindings + test fixtures
        legitimately want native types.
    -->
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint.MissingNativeTypeHint">
        <include-pattern>src/Module/*</include-pattern>
        <include-pattern>tests/*</include-pattern>
    </rule>

    <!--
        BearSunday.Di.NoNewService forbids `new` in /Resource/, /Service/,
        /Domain/. The path-based trigger also fires under tests/Resource/*,
        but unit tests legitimately instantiate Page resources directly to
        drive narrow exception paths (see ArticleTest::testCreateThrowsWhenNoAuthorRegistered).
    -->
    <rule ref="BearSunday.Di.NoNewService">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
