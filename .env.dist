# Copy to .env for local development. Values consumed by src/Module/AppModule.php.
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=bear_cms;charset=utf8mb4
DB_USER=root
DB_PASSWORD=

# Google OAuth for Page/Admin login. Empty values are fine in fake/test
# contexts — those use FakeAuthProvider / FakeAuthSession.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8081/admin/callback

# Public origin of the site (scheme + host[:port]). Required in production: the
# same-origin gate rejects other origins, and an https scheme marks the session
# and Auth0 cookies Secure even when a proxy terminates TLS.
CMS_ALLOWED_ORIGIN=

# Auth provider selection. Supported values: google, auth0.
CMS_AUTH_PROVIDER=google

# Auth0/OIDC for Page/Admin login when CMS_AUTH_PROVIDER=auth0.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://127.0.0.1:8081/admin/callback
AUTH0_AUDIENCE=
AUTH0_COOKIE_SECRET=

# #[InputFile] media upload demo.
CMS_UPLOAD_DIR=
CMS_UPLOAD_BASE_URL=/uploads

# Optional production QueryRepository storage. Leave empty for local file/APCu cache.
CMS_REDIS_DSN=
