{
    "name": "bear/kata",
    "type": "project",
    "license": "MIT",
    "description": "Reference CMS for BEAR.Sunday: ALPS-driven, BDR pattern, App-resource only.",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bearsunday/BEAR.Csrf"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bearsunday/BEAR.Resource"
        }
    ],
    "require": {
        "php": "^8.5.0",
        "auth0/auth0-php": "^8.19",
        "bear/async": "^0.3",
        "bear/package": "^1.14",
        "bear/qiq-module": "^2.0",
        "bear/query-repository": "^1.16",
        "bear/resource": "1.x-dev",
        "bear/streamer": "^1.4",
        "bear/sunday": "^1.6",
        "koriym/env-json": "^1.0",
        "league/commonmark": "^2.8",
        "league/oauth2-google": "^5.0",
        "qiq/qiq": "^3.0",
        "ray/aop": "^2.12",
        "ray/aura-sql-module": "^1.17",
        "bear/csrf": "^0.1",
        "ray/di": "^2.14",
        "ray/input-query": "^1.0",
        "ray/media-query": "^1.1"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.4",
        "bear/api-doc": "^1.11",
        "bear/cli": "^1.0",
        "bear/devtools": "^1.0",
        "bear/security": "^0.1",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "justinrainbow/json-schema": "^6.8",
        "phpunit/phpunit": "^10.0",
        "roave/security-advisories": "dev-latest",
        "bear/defer": "^0.1.0",
        "bear/event-sourcing": "1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\Kata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\Kata\\": "tests/",
            "BEAR\\Kata\\Example\\ImportedCatalog\\": "examples/import/ImportedCatalog/src/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@setup",
            "@composer bin all install --ansi"
        ],
        "setup": "php bin/setup.php",
        "setup:docs": "php bin/setup-docs.php",
        "compile": "./vendor/bin/bear.compile 'BEAR\\Kata' prod-app ./",
        "doc": [
            "@setup:docs",
            "mkdir -p docs/examples",
            "cp var/fake/*.json docs/examples/",
            "./vendor/bin/apidoc",
            "npm run doc:alps --silent",
            "perl -0pi -e 's/## Findings/## Audit Scope\\nThis report checks the metadata fields used by the BEAR.ApiDoc audit pass. OpenAPI summaries can be derived separately, so a `Missing operation summary` finding can remain even when `docs\\/openapi.json` has a non-empty `summary`. Treat it as a prompt to add explicit source summaries for the audit pass.\\n\\n## Findings/' docs/audit.md",
            "perl -0pi -e 's/[ \\t]+$//mg' docs/index.html docs/alps.html docs/terms.html"
        ],
        "fake": "php bin/semantic-ex/gen-fake.php",
        "schema": "php bin/semantic-ex/gen-schemas.php",
        "semantic": [
            "@fake",
            "@schema"
        ],
        "cli": "./vendor/bin/bear-cli-gen 'BEAR\\Kata'",
        "malt:up": [
            "malt install",
            "malt start",
            "@malt:db"
        ],
        "malt:down": "malt stop",
        "malt:db": [
            "mysql -h 127.0.0.1 -uroot -e 'CREATE DATABASE IF NOT EXISTS bear_cms'",
            "DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=bear_cms;charset=utf8mb4' DB_USER=root DB_PASSWORD= ./vendor/bin/doctrine-migrations migrate --no-interaction",
            "DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=bear_cms;charset=utf8mb4' DB_USER=root DB_PASSWORD= php bin/seed.php"
        ],
        "docker:up": [
            "docker compose up -d --wait mysql",
            "@docker:db"
        ],
        "docker:down": "docker compose down",
        "docker:db": [
            "DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=bear_cms;charset=utf8mb4' DB_USER=root DB_PASSWORD=root ./vendor/bin/doctrine-migrations migrate --no-interaction",
            "DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=bear_cms;charset=utf8mb4' DB_USER=root DB_PASSWORD=root php bin/seed.php"
        ],
        "parallel:up": [
            "@docker:up",
            "docker compose up -d --wait parallel",
            "docker compose exec -T parallel composer install --no-interaction --prefer-dist --ignore-platform-req=php"
        ],
        "parallel:down": "docker compose stop parallel",
        "parallel:demo": "docker compose exec -T parallel php bin/async.php get 'app://self/article?id=1'",
        "swoole:up": [
            "@docker:up",
            "docker compose up -d --wait swoole",
            "docker compose exec -T swoole composer install --no-interaction --prefer-dist --ignore-platform-req=php"
        ],
        "swoole:down": "docker compose stop swoole",
        "sqlite:up": [
            "rm -f /tmp/bear_cms.db",
            "DB_DSN='sqlite:/tmp/bear_cms.db' ./vendor/bin/doctrine-migrations migrate --no-interaction",
            "DB_DSN='sqlite:/tmp/bear_cms.db' php bin/seed.php"
        ],
        "test": "./vendor/bin/phpunit",
        "coverage": "php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage",
        "pcov": "php -dextension=pcov.so -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage  --coverage-clover=coverage.xml",
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf src tests",
        "metrics": "./vendor/bin/phpmetrics --report-html=build/metrics --exclude=Exception src",
        "clean": [
            "./vendor/bin/phpstan clear-result-cache",
            "./vendor/bin/psalm --clear-cache",
            "rm -rf ./var/tmp/*"
        ],
        "sa": [
            "./vendor/bin/psalm --show-info=true",
            "./vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=512M"
        ],
        "phpmd": "php -d error_reporting=22527 ./vendor/bin/phpmd src,bin text ./phpmd.xml --exclude \"bin/semantic-ex/*\"",
        "security": [
            "@security:sast",
            "@security:taint"
        ],
        "security:sast": [
            "./vendor/bin/bear.security-scan src"
        ],
        "security:taint": "./vendor/bin/psalm --taint-analysis src",
        "tests": [
            "@cs",
            "@sa",
            "@phpmd",
            "@test"
        ],
        "build": [
            "@clean",
            "@cs",
            "@sa",
            "@pcov",
            "@compile",
            "@metrics"
        ],
        "serve": "COMPOSER_PROCESS_TIMEOUT=0 php -S 127.0.0.1:8081 -t public public/page.php",
        "serve:api": "COMPOSER_PROCESS_TIMEOUT=0 php -dzend_extension=xdebug.so -S 127.0.0.1:8080 -t public",
        "app": "php bin/app.php",
        "async": "php bin/async.php",
        "page": "php bin/page.php",
        "profile": "php -dzend_extension=xdebug.so -dxdebug.mode=profile -dxdebug.output_dir=./var/log -dxdebug.profiler_output_name=cachegrind.out.%t bin/page.php get /",
        "demo": "php bin/demo.php",
        "demo:variations": "php bin/demo-variations.php",
        "demo:cache": "php bin/demo-cache.php"
    },
    "scripts-descriptions": {
        "setup": "Clear generated DI/runtime cache",
        "setup:docs": "Install npm dependencies for generated documentation",
        "compile": "Compile scripts for the production",
        "doc": "Generate API document",
        "test": "Run unit tests",
        "tests": "Run tests and quality checks",
        "coverage": "Generate test coverage report",
        "pcov": "Generate test coverage report (pcov)",
        "cs": "Checks the coding standard",
        "cs-fix": "Fix the coding standard",
        "sa": "Run static analysis",
        "phpmd": "Detect code quality issues",
        "security": "Run security scan",
        "metrics": "Build metrics report",
        "clean": "Clear cache files",
        "serve": "Start built-in server for Qiq/Page HTML at http://127.0.0.1:8081",
        "serve:api": "Start built-in server for HAL JSON API at http://127.0.0.1:8080",
        "docker:up": "Start only MySQL and run migrations/seeding; runtime containers are opt-in via parallel:up or swoole:up",
        "docker:down": "Stop all docker-compose services",
        "app": "Request app resource (sync linker)",
        "async": "Request app resource via the ext-parallel async linker (Article's #[Embed]s run in parallel; requires ext-parallel + ZTS PHP)",
        "parallel:up": "Build & start the ext-parallel Docker container (provides ZTS PHP + ext-parallel for bin/async.php) + migrate/seed MySQL",
        "parallel:down": "Stop the ext-parallel container",
        "parallel:demo": "Exec `php bin/async.php get app://self/article?id=1` inside the ext-parallel container",
        "swoole:up": "Build & start the ext-swoole Docker container (provides ZTS PHP + ext-swoole) + migrate/seed MySQL",
        "swoole:down": "Stop the ext-swoole container",
        "page": "Request page resource",
        "profile": "Profile page request (customize endpoint as needed)",
        "demo:variations": "Run the Article GET variations demo",
        "demo:cache": "Run the QueryRepository cache showcase (#[Embed] + one-line fromAssoc, hermetic ArrayAdapter)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false
        }
    }
}
