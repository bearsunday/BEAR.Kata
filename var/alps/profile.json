{
  "$schema": "https://alps-io.github.io/schemas/alps.json",
  "alps": {
    "title": "BEAR.Cms Reference CMS",
    "doc": {
      "value": "ALPS profile for the BEAR.Cms App resource API. Covers articles, categories, tags, authors and media with read and write transitions."
    },
    "link": [
      {"rel": "apidoc", "href": "index.html"},
      {"rel": "alps", "href": "alps.html"},
      {"rel": "diagram", "href": "alps.svg"},
      {"rel": "openapi", "href": "openapi.json"},
      {"rel": "llms", "href": "llms.txt"},
      {"rel": "terms", "href": "terms.html"},
      {"rel": "terms-markdown", "href": "terms.md"},
      {"rel": "audit", "href": "audit.md"},
      {"rel": "schemas", "href": "schemas/"}
    ],
    "descriptor": [
      {"id": "id", "title": "Identifier", "def": "https://schema.org/identifier"},
      {"id": "slug", "title": "URL-safe Slug", "doc": {"value": "Lower-case kebab-case unique identifier used in human-readable URIs."}},
      {"id": "name", "title": "Name", "def": "https://schema.org/name"},
      {"id": "title", "title": "Title", "def": "https://schema.org/headline"},
      {"id": "body", "title": "Article Body", "def": "https://schema.org/articleBody"},
      {"id": "excerpt", "title": "Excerpt", "doc": {"value": "Short summary used in list views."}},
      {"id": "status", "title": "Lifecycle Status", "doc": {"value": "draft or published."}},
      {"id": "publishedAt", "title": "Published At", "def": "https://schema.org/datePublished"},
      {"id": "description", "title": "Description", "def": "https://schema.org/description"},
      {"id": "email", "title": "Email", "def": "https://schema.org/email"},
      {"id": "bio", "title": "Biography", "def": "https://schema.org/description"},
      {"id": "filename", "title": "Filename"},
      {"id": "file", "title": "Uploaded File", "doc": {"value": "Binary file body resolved by Ray.InputQuery #[InputFile]."}},
      {"id": "mimeType", "title": "MIME Type", "def": "https://schema.org/encodingFormat"},
      {"id": "url", "title": "URL", "def": "https://schema.org/contentUrl"},
      {"id": "alt", "title": "Alt Text", "doc": {"value": "Accessibility text describing the media."}},
      {"id": "width", "title": "Width", "def": "https://schema.org/width"},
      {"id": "height", "title": "Height", "def": "https://schema.org/height"},

      {"id": "authorId", "title": "Author ID (FK)"},
      {"id": "categoryId", "title": "Category ID (FK)"},
      {"id": "parentId", "title": "Parent Category ID (self-FK)", "doc": {"value": "Nullable reference for hierarchical categories."}},
      {"id": "tagId", "title": "Tag ID (filter)"},
      {"id": "articleId", "title": "Article ID (filter)"},

      {"id": "page", "title": "Page Number", "doc": {"value": "1-indexed pagination page."}},
      {"id": "perPage", "title": "Per-Page Count"},
      {"id": "totalCount", "title": "Total Count"},

      {"id": "Article", "title": "Article Detail", "doc": {"value": "Single article with embedded Author, Category and Tags."}, "descriptor": [
        {"href": "#id"},
        {"href": "#slug"},
        {"href": "#title"},
        {"href": "#body"},
        {"href": "#excerpt"},
        {"href": "#status"},
        {"href": "#publishedAt"},
        {"href": "#authorId"},
        {"href": "#categoryId"},
        {"href": "#Author"},
        {"href": "#Category"},
        {"href": "#Tag"},
        {"href": "#goArticleList"},
        {"href": "#goAuthor"},
        {"href": "#goCategory"},
        {"href": "#doUpdateArticle"},
        {"href": "#doDeleteArticle"},
        {"href": "#doPublishArticle"}
      ], "tag": "article"},

      {"id": "ArticleList", "title": "Article List", "doc": {"value": "Paginated list of articles; supports filtering by category, tag, or status."}, "descriptor": [
        {"href": "#id"},
        {"href": "#slug"},
        {"href": "#title"},
        {"href": "#excerpt"},
        {"href": "#status"},
        {"href": "#publishedAt"},
        {"href": "#page"},
        {"href": "#perPage"},
        {"href": "#totalCount"},
        {"href": "#goArticle"},
        {"href": "#doCreateArticle"}
      ], "tag": "article flow-browse"},

      {"id": "Category", "title": "Category Detail", "descriptor": [
        {"href": "#id"},
        {"href": "#slug"},
        {"href": "#name"},
        {"href": "#description"},
        {"href": "#parentId"},
        {"href": "#goCategoryList"},
        {"href": "#goArticleList"},
        {"href": "#doUpdateCategory"},
        {"href": "#doDeleteCategory"}
      ], "tag": "category"},

      {"id": "CategoryList", "title": "Category List", "descriptor": [
        {"href": "#id"},
        {"href": "#slug"},
        {"href": "#name"},
        {"href": "#parentId"},
        {"href": "#goCategory"},
        {"href": "#doCreateCategory"}
      ], "tag": "category flow-browse"},

      {"id": "Tag", "title": "Tag Detail", "descriptor": [
        {"href": "#id"},
        {"href": "#slug"},
        {"href": "#name"},
        {"href": "#goTagList"},
        {"href": "#goArticleList"},
        {"href": "#doDeleteTag"}
      ], "tag": "tag"},

      {"id": "TagList", "title": "Tag List", "descriptor": [
        {"href": "#id"},
        {"href": "#slug"},
        {"href": "#name"},
        {"href": "#goTag"},
        {"href": "#doCreateTag"}
      ], "tag": "tag flow-browse"},

      {"id": "Author", "title": "Author Detail", "descriptor": [
        {"href": "#id"},
        {"href": "#name"},
        {"href": "#email"},
        {"href": "#bio"},
        {"href": "#goArticleList"},
        {"href": "#doUpdateAuthor"}
      ], "tag": "author"},

      {"id": "AuthorList", "title": "Author List", "doc": {"value": "List of authors."}, "descriptor": [
        {"href": "#id"},
        {"href": "#name"},
        {"href": "#email"},
        {"href": "#bio"},
        {"href": "#goAuthor"},
        {"href": "#doCreateAuthor"}
      ], "tag": "author flow-browse"},

      {"id": "Media", "title": "Media Detail", "descriptor": [
        {"href": "#id"},
        {"href": "#filename"},
        {"href": "#mimeType"},
        {"href": "#url"},
        {"href": "#alt"},
        {"href": "#width"},
        {"href": "#height"},
        {"href": "#doUploadMediaFile"},
        {"href": "#doDeleteMedia"}
      ], "tag": "media"},

      {"id": "goArticleList", "type": "safe", "rt": "#ArticleList", "title": "View Article List", "doc": {"value": "List published articles, filterable by category, tag or status."}, "tag": "article flow-browse", "descriptor": [
        {"href": "#page"},
        {"href": "#perPage"},
        {"href": "#categoryId"},
        {"href": "#tagId"},
        {"href": "#status"}
      ]},
      {"id": "goArticle", "type": "safe", "rt": "#Article", "title": "View Article", "doc": {"value": "Retrieve a single article by id with embedded Author/Category/Tags."}, "tag": "article", "descriptor": [
        {"href": "#id"}
      ]},
      {"id": "goCategoryList", "type": "safe", "rt": "#CategoryList", "title": "View Category List", "tag": "category flow-browse"},
      {"id": "goCategory", "type": "safe", "rt": "#Category", "title": "View Category", "tag": "category", "descriptor": [
        {"href": "#id"}
      ]},
      {"id": "goTagList", "type": "safe", "rt": "#TagList", "title": "View Tag List", "tag": "tag flow-browse"},
      {"id": "goTag", "type": "safe", "rt": "#Tag", "title": "View Tag", "tag": "tag", "descriptor": [
        {"href": "#id"}
      ]},
      {"id": "goAuthorList", "type": "safe", "rt": "#AuthorList", "title": "View Author List", "tag": "author flow-browse"},
      {"id": "goAuthor", "type": "safe", "rt": "#Author", "title": "View Author", "tag": "author", "descriptor": [
        {"href": "#id"}
      ]},
      {"id": "goMedia", "type": "safe", "rt": "#Media", "title": "View Media", "tag": "media", "descriptor": [
        {"href": "#id"}
      ]},

      {"id": "doCreateArticle", "type": "unsafe", "rt": "#Article", "title": "Create Article", "doc": {"value": "Create a new article. Returns the created article detail."}, "tag": "article flow-publish", "descriptor": [
        {"href": "#slug"},
        {"href": "#title"},
        {"href": "#body"},
        {"href": "#excerpt"},
        {"href": "#status"},
        {"href": "#authorId"},
        {"href": "#categoryId"}
      ]},
      {"id": "doUpdateArticle", "type": "idempotent", "rt": "#Article", "title": "Update Article", "tag": "article flow-publish", "descriptor": [
        {"href": "#id"},
        {"href": "#title"},
        {"href": "#body"},
        {"href": "#excerpt"},
        {"href": "#status"}
      ]},
      {"id": "doDeleteArticle", "type": "idempotent", "rt": "#ArticleList", "title": "Delete Article", "tag": "article flow-publish", "descriptor": [
        {"href": "#id"}
      ]},
      {"id": "doPublishArticle", "type": "unsafe", "rt": "#Article", "title": "Publish Article", "doc": {"value": "Move a draft article to published. Non-idempotent: a second call on an already-published article returns 409 Conflict (the state machine guards against re-publishing)."}, "tag": "article flow-publish", "descriptor": [
        {"href": "#id"},
        {"href": "#publishedAt"}
      ]},

      {"id": "doCreateCategory", "type": "unsafe", "rt": "#Category", "title": "Create Category", "tag": "category", "descriptor": [
        {"href": "#slug"},
        {"href": "#name"},
        {"href": "#description"},
        {"href": "#parentId"}
      ]},
      {"id": "doUpdateCategory", "type": "idempotent", "rt": "#Category", "title": "Update Category", "tag": "category", "descriptor": [
        {"href": "#id"},
        {"href": "#name"},
        {"href": "#description"},
        {"href": "#parentId"}
      ]},
      {"id": "doDeleteCategory", "type": "idempotent", "rt": "#CategoryList", "title": "Delete Category", "tag": "category", "descriptor": [
        {"href": "#id"}
      ]},

      {"id": "doCreateTag", "type": "unsafe", "rt": "#Tag", "title": "Create Tag", "tag": "tag", "descriptor": [
        {"href": "#slug"},
        {"href": "#name"}
      ]},
      {"id": "doDeleteTag", "type": "idempotent", "rt": "#TagList", "title": "Delete Tag", "tag": "tag", "descriptor": [
        {"href": "#id"}
      ]},

      {"id": "doCreateAuthor", "type": "unsafe", "rt": "#Author", "title": "Create Author", "tag": "author", "descriptor": [
        {"href": "#name"},
        {"href": "#email"},
        {"href": "#bio"}
      ]},
      {"id": "doUpdateAuthor", "type": "idempotent", "rt": "#Author", "title": "Update Author", "tag": "author", "descriptor": [
        {"href": "#id"},
        {"href": "#name"},
        {"href": "#email"},
        {"href": "#bio"}
      ]},

      {"id": "doCreateMedia", "type": "unsafe", "rt": "#Media", "title": "Upload Media", "tag": "media", "descriptor": [
        {"href": "#filename"},
        {"href": "#mimeType"},
        {"href": "#url"},
        {"href": "#alt"},
        {"href": "#width"},
        {"href": "#height"}
      ]},
      {"id": "doUploadMediaFile", "type": "unsafe", "rt": "#Media", "title": "Upload Media File", "tag": "media", "descriptor": [
        {"href": "#file"},
        {"href": "#alt"}
      ]},
      {"id": "doDeleteMedia", "type": "idempotent", "rt": "#Media", "title": "Delete Media", "tag": "media", "descriptor": [
        {"href": "#id"}
      ]}
    ]
  }
}
